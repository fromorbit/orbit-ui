{
  "name": "@fromorbit/doc-view",
  "version": "0.1.8",
  "description": "The document view of Orbit: Markdown, its outline and the kind of a document, drawn with React.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fromorbit/orbit-ui.git",
    "directory": "packages/doc-view"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "fixtures",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@fromorbit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shiki-bundle": {
      "@fromorbit/source": "./src/shiki-bundle.ts",
      "types": "./dist/shiki-bundle.d.ts",
      "import": "./dist/shiki-bundle.js",
      "default": "./dist/shiki-bundle.js"
    },
    "./doc-view.css": {
      "@fromorbit/source": "./src/doc-view.css",
      "default": "./dist/doc-view.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "vitest run --config vitest.consumer.config.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs && cp src/doc-view.css dist/doc-view.css",
    "verify": "node ../../scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "@shikijs/langs": "^4.4.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@shikijs/langs": "^4.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  }
}
