{
  "name": "@fromorbit/ui",
  "version": "0.2.0",
  "description": "The interface building blocks of Orbit: primitives, overlays, patterns and the design tokens.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fromorbit/orbit-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "default": "./dist/tokens.css"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    },
    "./fonts.css": {
      "default": "./dist/fonts.css"
    },
    "./gallery": {
      "types": "./dist/gallery/index.d.ts",
      "import": "./dist/gallery/index.js",
      "default": "./dist/gallery/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "vitest run --config vitest.consumer.config.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs && cp src/tokens.css src/theme.css src/fonts.css dist/",
    "gallery": "vite --config docs-site/vite.config.ts",
    "gallery:build": "vite build --config docs-site/vite.config.ts",
    "gallery:publish": "sh scripts/publish-docs.sh",
    "verify": "node ../../scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "@fromorbit/doc-view": "^0.1.8",
    "@pierre/diffs": "^1.4.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@testing-library/react": "^16.3.3",
    "lucide-react": "^1.47.0",
    "radix-ui": "~1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fromorbit/doc-view": "workspace:*",
    "@pierre/diffs": "^1.4.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@shikijs/langs": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.47.0",
    "radix-ui": "~1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  }
}
